---
interface Props { size?: string; label?: string }
const { size = 'min(80vw, 28rem)', label = '玉衡核心：青玉球与衔尾蛇环' } = Astro.props;
const uid = 'nova-' + crypto.randomUUID();
const ref = (name: string) => 'url(#' + uid + '-' + name + ')';
---
<div class="nova-core" style={'--nova-size:' + size} data-nova-core role="img" aria-label={label}>
  <svg class="instrument" viewBox="0 0 400 420" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id={uid + '-jade'} cx="32%" cy="25%" r="76%"><stop stop-color="#fffef0" stop-opacity=".94"/><stop offset=".2" stop-color="#c9e6d5" stop-opacity=".83"/><stop offset=".48" stop-color="#70af96" stop-opacity=".76"/><stop offset=".78" stop-color="#387a68" stop-opacity=".85"/><stop offset="1" stop-color="#aecab2" stop-opacity=".92"/></radialGradient>
      <linearGradient id={uid + '-gold'} x1="0" y1="0" x2=".7" y2="1"><stop stop-color="#fff0c4"/><stop offset=".19" stop-color="#b98248"/><stop offset=".42" stop-color="#f7dfaa"/><stop offset=".7" stop-color="#956536"/><stop offset="1" stop-color="#e6c58a"/></linearGradient>
      <linearGradient id={uid + '-snake'} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#d9eee0"/><stop offset=".25" stop-color="#82b8a5"/><stop offset=".55" stop-color="#3c7f6e"/><stop offset=".8" stop-color="#b7d5be"/><stop offset="1" stop-color="#4d8775"/></linearGradient>
      <radialGradient id={uid + '-pearl'} cx="36%" cy="28%"><stop stop-color="#fff"/><stop offset=".55" stop-color="#fff2d6" stop-opacity=".8"/><stop offset="1" stop-color="#d0b584" stop-opacity=".25"/></radialGradient>
      <pattern id={uid + '-mesh'} width="23" height="23" patternUnits="userSpaceOnUse" patternTransform="rotate(38)"><path d="M0 0h23M0 0v23" fill="none" stroke="#efd49a" stroke-width="1.4"/><path d="M1 1h21v21" fill="none" stroke="#79542c" stroke-opacity=".6" stroke-width=".6"/></pattern>
      <mask id={uid + '-body'}><rect width="400" height="420" fill="black"/><path d="M306 86 C251 25 136 22 80 91 C24 158 40 267 101 315 C157 359 247 360 306 315 C366 269 369 169 320 107" fill="none" stroke="white" stroke-width="31" stroke-linecap="round"/></mask>
    </defs>
    <ellipse cx="200" cy="376" rx="129" ry="9" fill="#3e6e5c" opacity=".18"/>
    <circle cx="200" cy="192" r="137" fill="none" stroke="#b78b57" opacity=".2" stroke-width="1"/><circle cx="200" cy="192" r="126" fill="none" stroke="#c6a472" opacity=".3" stroke-width="1"/>
    <path d="M306 86 C251 25 136 22 80 91 C24 158 40 267 101 315 C157 359 247 360 306 315 C366 269 369 169 320 107" fill="none" stroke={ref('gold')} stroke-width="36" stroke-linecap="round"/>
    <path d="M306 86 C251 25 136 22 80 91 C24 158 40 267 101 315 C157 359 247 360 306 315 C366 269 369 169 320 107" fill="none" stroke={ref('snake')} stroke-width="30" stroke-linecap="round"/>
    <rect width="400" height="420" fill={ref('mesh')} mask={ref('body')} opacity=".95"/>
    <circle cx="200" cy="194" r="109" fill={ref('jade')} stroke="#d8e5ca" stroke-width="3"/>
    <circle cx="200" cy="194" r="103" fill="none" stroke="#fffbed" stroke-opacity=".6" stroke-width="2"/>
    <path d="M110 155 C128 100 165 81 211 85 C178 92 159 113 151 141 C138 140 121 147 110 155Z" fill="#f4fff1" opacity=".48"/>
    <path d="M116 169 Q120 101 190 91 M100 203 Q105 257 145 282 M262 108 Q305 143 302 185 M286 247 Q273 287 230 296" fill="none" stroke="#fffef2" stroke-width="5" opacity=".5"/>
    <path d="M130 124 Q159 144 149 167 M275 117 Q254 135 264 157 M114 245 Q143 231 154 259 M257 269 Q281 263 291 241" fill="none" stroke="#a3ddbd" stroke-width="4" opacity=".8"/>
    <ellipse cx="200" cy="194" rx="82" ry="103" fill="none" stroke="#f7ecc8" stroke-width="2" opacity=".48" transform="rotate(28 200 194)"/>
    <g fill={ref('gold')} stroke="#8b613a" stroke-width="1"><rect x="194" y="65" width="12" height="260" rx="5"/><rect x="184" y="85" width="32" height="9" rx="3"/><rect x="184" y="294" width="32" height="9" rx="3"/></g>
    <rect x="197" y="98" width="6" height="192" fill="#a8ddbd" opacity=".8"/>
    <circle cx="200" cy="192" r="42" fill={ref('pearl')} stroke="#fffbea" stroke-opacity=".8" stroke-width="2"/>
    <g transform="rotate(-18 200 194)"><ellipse cx="200" cy="194" rx="119" ry="47" fill="none" stroke="#78512f" stroke-width="17"/><ellipse cx="200" cy="192" rx="119" ry="47" fill="none" stroke={ref('gold')} stroke-width="13"/><ellipse cx="200" cy="190" rx="119" ry="47" fill="none" stroke="#fff1cb" stroke-opacity=".8" stroke-width="1.5"/><path d="M96 216 Q156 246 228 240 T304 216" fill="none" stroke="#7f5834" stroke-width="1"/><g fill="#f8ebc9" stroke="#8e653a" stroke-width="1"><circle cx="108" cy="219" r="3"/><circle cx="124" cy="226" r="3"/><circle cx="144" cy="232" r="3"/><circle cx="165" cy="236" r="3"/><circle cx="185" cy="239" r="3"/></g><path d="M246 237 265 232 278 220 293 218 303 207" fill="none" stroke="#fff6d0" stroke-width="1.4"/><g fill="#fff8d7"><circle cx="246" cy="237" r="2.5"/><circle cx="265" cy="232" r="2.5"/><circle cx="278" cy="220" r="2.5"/><circle cx="293" cy="218" r="2.5"/><circle cx="303" cy="207" r="2.5"/></g></g>
    <g transform="translate(215 221) rotate(-18)"><rect x="-18" y="-18" width="36" height="36" rx="2" fill={ref('gold')} stroke="#8f6034" stroke-width="2"/><rect x="-14" y="-14" width="28" height="28" fill="#d9bd86" stroke="#fff0c5"/><g fill="#294c40"><circle cx="-8" cy="-8" r="2.4"/><circle cx="0" cy="-8" r="2.4"/><circle cx="8" cy="-8" r="2.4"/><circle cx="-8" cy="0" r="2.4"/><circle cx="0" cy="0" r="2.4"/><circle cx="8" cy="0" r="2.4"/><circle cx="-8" cy="8" r="2.4"/><circle cx="0" cy="8" r="2.4"/><circle cx="8" cy="8" r="2.4"/></g></g>
    <g fill={ref('gold')} stroke="#8c623a" stroke-width="1"><rect x="47" y="179" width="28" height="16" rx="6"/><rect x="325" y="179" width="28" height="16" rx="6"/><rect x="190" y="51" width="20" height="16" rx="4"/></g>
    <path d="M275 56 Q297 46 318 61 Q335 72 334 84 Q331 94 318 95 L309 103 Q299 95 283 92 Q267 86 262 76 Q259 64 275 56Z" fill={ref('gold')} stroke="#916237" stroke-width="2"/><path d="M267 66 Q279 66 292 79 M273 59 Q287 60 299 73 M280 55 Q295 58 306 68 M289 53 Q302 58 313 68" fill="none" stroke="#876038" stroke-width="1.3"/><ellipse cx="306" cy="76" rx="7" ry="6" fill="#285b47" stroke="#f3d59b" stroke-width="2"/><circle cx="308" cy="74" r="2" fill="#f8ffea"/><circle cx="325" cy="84" r="2" fill="#74502d"/><path d="M315 92 Q321 90 327 91" fill="none" stroke="#4e3825" stroke-width="2"/>
    <g transform="translate(318 286)"><path d="M0 0v20" stroke={ref('gold')} stroke-width="5"/><rect x="-15" y="18" width="30" height="47" rx="5" fill="#d6e3c9" stroke={ref('gold')} stroke-width="4"/><text x="0" y="36" text-anchor="middle" fill="#a73b29" font-size="14" font-family="serif">辛</text><text x="0" y="53" text-anchor="middle" fill="#a73b29" font-size="14" font-family="serif">巳</text></g>
    <g transform="translate(200 330)"><circle r="31" fill={ref('gold')} stroke="#8d6035" stroke-width="3"/><circle r="25" fill="#b99260" stroke="#f7dda4" stroke-width="2"/><path d="M-13 11 Q-9-6 0-9 Q9-6 13 11 M-7-11 Q-6-22 0-22 Q6-22 7-11 Q4-3 0-2 Q-4-3-7-11Z" fill="#ead09e" stroke="#795330" stroke-width="1.5"/><path d="M-11 16 Q0 9 11 16" fill="none" stroke="#775431" stroke-width="2"/></g>
  </svg><canvas aria-hidden="true"></canvas>
</div>
<style>
.nova-core{position:relative;width:var(--nova-size);max-width:100%;aspect-ratio:400/420;margin-inline:auto;isolation:isolate;overflow:hidden}.instrument,canvas{position:absolute;inset:0;width:100%;height:100%}.instrument{display:block}.nova-core canvas{display:block;opacity:.12;pointer-events:none}@media(prefers-reduced-motion:reduce){.nova-core canvas{display:none}}
</style>
<script>
import { mountNovaCore } from '../scripts/nova-core';
mountNovaCore();
</script>