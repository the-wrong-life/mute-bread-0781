---
interface Props { size?: string; label?: string }
const { size = 'min(80vw, 28rem)', label = 'NOVA Core' } = Astro.props;
---
<div class="nova-core" style={'--nova-size:' + size} data-nova-core role="img" aria-label={label}>
  <canvas aria-hidden="true"></canvas>
  <div class="fallback" aria-hidden="true"><span></span></div>
</div>
<style>
.nova-core{position:relative;width:var(--nova-size);max-width:100%;aspect-ratio:1;margin-inline:auto}
canvas,.fallback{position:absolute;inset:0;width:100%;height:100%}
canvas{display:block}
.fallback{display:block;border-radius:50%;background:radial-gradient(circle at 32% 28%,#fff 0%,#7bdaed 10%,#287b9d 32%,#18355d 62%,#090e1c 100%);box-shadow:inset -1rem -2rem 3rem #020510aa,0 0 2rem #4cb9d43b}
.fallback span{position:absolute;inset:16%;border:1px solid #bff3ff88;border-radius:50%;transform:rotate(-28deg) scaleY(.35)}
.nova-core.ready .fallback{display:none}
</style>
<script>
import { mountNovaCore } from '../scripts/nova-core';
mountNovaCore();
</script>
