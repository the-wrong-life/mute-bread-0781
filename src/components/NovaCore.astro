---
interface Props { size?: string; label?: string }
const { size = 'min(80vw, 28rem)', label = '玉衡核心' } = Astro.props;
---
<div class="nova-core" style={'--nova-size:' + size} data-nova-core role="img" aria-label={label}>
  <svg class="instrument" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="jade" cx="34%" cy="27%" r="78%"><stop stop-color="#b5dfc4"/><stop offset=".24" stop-color="#4d9d82"/><stop offset=".68" stop-color="#176353"/><stop offset="1" stop-color="#0b302d"/></radialGradient>
      <linearGradient id="bronze" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#f0d49a"/><stop offset=".28" stop-color="#9c7440"/><stop offset=".52" stop-color="#ead49c"/><stop offset=".78" stop-color="#74552f"/><stop offset="1" stop-color="#d0ad6d"/></linearGradient>
      <filter id="shadow" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="7"/></filter>
    </defs>
    <circle cx="200" cy="207" r="164" fill="#041412" opacity=".45" filter="url(#shadow)"/>
    <circle cx="200" cy="200" r="169" fill="none" stroke="url(#bronze)" stroke-width="7"/>
    <circle cx="200" cy="200" r="158" fill="none" stroke="#d7bd84" stroke-opacity=".45" stroke-width="1"/>
    <g stroke="#dfc58e" stroke-width="2" opacity=".8">
      <path d="M200 22v13M200 365v13M22 200h13M365 200h13"/>
      <path d="m74 74 9 9m234 234 9 9M326 74l-9 9M83 317l-9 9"/>
    </g>
    <g stroke="#d8c395" stroke-width="1" opacity=".5">
      <path d="M200 34v8M200 358v8M34 200h8M358 200h8"/>
      <path d="M117 52l3 7m160 282 3 7M52 117l7 3m282 160 7 3M283 52l-3 7M120 341l-3 7M348 117l-7 3M59 280l-7 3"/>
    </g>
    <circle cx="200" cy="200" r="139" fill="url(#jade)" stroke="#8db89b" stroke-width="2"/>
    <circle cx="200" cy="200" r="128" fill="none" stroke="#d9e4c0" stroke-opacity=".35"/>
    <path d="M91 211 C105 143 158 103 220 112 C274 120 307 164 299 211 C291 255 248 282 203 272 C161 263 143 230 155 197 C166 169 200 156 226 169 C247 180 253 201 243 218 C233 235 211 240 196 229 C184 220 184 204 194 196 C203 188 216 193 219 202" fill="none" stroke="#d3e6bd" stroke-width="11" stroke-linecap="round" opacity=".88"/>
    <path d="M91 211 C105 143 158 103 220 112 C274 120 307 164 299 211 C291 255 248 282 203 272 C161 263 143 230 155 197 C166 169 200 156 226 169 C247 180 253 201 243 218 C233 235 211 240 196 229 C184 220 184 204 194 196 C203 188 216 193 219 202" fill="none" stroke="#f0d69b" stroke-width="2" stroke-linecap="round" opacity=".85"/>
    <g fill="#f0d9a5" stroke="#725a36" stroke-width="1.5">
      <circle cx="91" cy="211" r="6"/><circle cx="299" cy="211" r="6"/><circle cx="219" cy="202" r="5"/>
    </g>
    <g stroke="url(#bronze)" stroke-width="5" fill="none" stroke-linecap="square">
      <path d="M78 191h18v18M304 191h18v18M190 87v18h18M190 295v18h18"/>
    </g>
    <g fill="#f4dfad">
      <path d="m246 94 3 8 8 3-8 3-3 8-3-8-8-3 8-3z"/><circle cx="265" cy="111" r="2"/><circle cx="230" cy="78" r="2"/><circle cx="279" cy="132" r="1.7"/>
    </g>
    <g transform="translate(268 271)"><path d="M-28-15h56v30h-56z" fill="#153d36" stroke="url(#bronze)" stroke-width="2"/><path d="M-21-9h42v18h-42z" fill="none" stroke="#d4bf8b" stroke-opacity=".65"/><text x="0" y="5" text-anchor="middle" fill="#f1dfb5" font-size="13" font-family="serif" letter-spacing="2">辛巳</text></g>
    <g transform="translate(200 200)" fill="none" stroke="#e4d2a3" stroke-width="2" opacity=".8"><path d="M0-22 6-6 22 0 6 6 0 22-6 6-22 0-6-6z"/><circle r="4" fill="#e4d2a3"/></g>
  </svg>
  <canvas aria-hidden="true"></canvas>
</div>
<style>
.nova-core{position:relative;width:var(--nova-size);max-width:100%;aspect-ratio:1;margin-inline:auto;isolation:isolate}
.instrument,canvas{position:absolute;inset:0;width:100%;height:100%}
.instrument{display:block;overflow:visible}
canvas{display:block;opacity:.22;pointer-events:none}
@media(prefers-reduced-motion:reduce){canvas{display:none}}
</style>
<script>
import { mountNovaCore } from '../scripts/nova-core';
mountNovaCore();
</script>