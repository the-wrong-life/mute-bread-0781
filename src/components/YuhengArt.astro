---
/**
 * 玉衡主视觉。
 *
 * §57（2026-11-14）：首页改为纯静态主视觉——用户要求"默认展示静态图、移除自动播放
 * 及相关首屏资源请求"。interactive 默认 false：既不预取循环动画，也不渲染播放按钮、
 * 不加任何 CSS 位移动画。只有显式传 interactive 的页面才有"播放动作"入口。
 */
interface Props {
  src?: string;
  srcSet?: string;
  alt: string;
  /** 主标注行，如 NOVA CORE · 玉衡 */
  caption?: string;
  /** 次标注行，参考图里位于主标注之下 */
  captionSub?: string;
  /** 循环动画素材；interactive 为 false 时不请求 */
  animSrc?: string;
  interactive?: boolean;
  showCaption?: boolean;
}
const {
  src = '/yuheng/yuheng-core.webp',
  srcSet = '/yuheng/yuheng-core-520.webp 520w, /yuheng/yuheng-core.webp 1040w',
  alt,
  caption = 'NOVA CORE · 玉衡',
  captionSub = '',
  animSrc = '/yuheng/yuheng-loop.webp',
  interactive = false,
  showCaption = true,
} = Astro.props;
---

<figure class="yuheng" data-yuheng data-static-src={src} data-anim-src={animSrc} data-interactive={interactive ? 'on' : 'off'}>
  <div class="yuheng-frame">
    <img
      class="yuheng-art"
      src={src}
      srcset={srcSet}
      sizes="(max-width: 860px) 92vw, min(41rem, 52vw)"
      width="1040"
      height="1040"
      alt={alt}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
  {showCaption && (
    <figcaption class="yuheng-caption">
      <span class="yuheng-caption-main">{caption}</span>
      {captionSub && <span class="yuheng-caption-sub">{captionSub}</span>}
      {interactive && <button class="yuheng-toggle" type="button" hidden aria-pressed="false">播放动作</button>}
    </figcaption>
  )}
</figure>

<script>
  // 只有 interactive 的实例才有按钮与预取逻辑；静态实例连监听都不注册。
  const figures = Array.from(document.querySelectorAll<HTMLElement>('[data-yuheng][data-interactive="on"]'));
  for (const fig of figures) {
    const img = fig.querySelector<HTMLImageElement>('.yuheng-art');
    const btn = fig.querySelector<HTMLButtonElement>('.yuheng-toggle');
    const staticSrc = fig.dataset.staticSrc || '';
    const animSrc = fig.dataset.animSrc || '';
    if (!img || !btn || !staticSrc || !animSrc) continue;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const conn = (navigator as unknown as { connection?: { saveData?: boolean; effectiveType?: string; downlink?: number } }).connection;
    const lightNet = conn?.saveData === true || /(^|-)2g$|(^|-)3g$/.test(conn?.effectiveType || '');
    const slowLink = typeof conn?.downlink === 'number' && conn.downlink < 1;
    const weakNet = lightNet || slowLink;
    let stored = (() => {
      try { return window.localStorage.getItem('yuheng-motion'); } catch { return null; }
    })();

    const staticSrcSet = img.getAttribute('srcset') || '';
    let pending: HTMLImageElement | null = null;
    let animFailed = false;
    const cancelLoad = () => {
      if (!pending) return;
      pending.onload = null;
      pending.onerror = null;
      pending.src = '';
      pending = null;
    };
    const showStatic = () => {
      cancelLoad();
      img.dataset.mode = 'static';
      img.srcset = staticSrcSet;
      img.src = staticSrc;
      btn.textContent = '播放动作';
      btn.setAttribute('aria-pressed', 'false');
      fig.dataset.anim = 'off';
    };
    const showAnim = () => {
      if (reduce.matches || lightNet || img.dataset.mode === 'anim' || pending) return;
      if (animFailed) { showStatic(); return; }
      const pre = new Image();
      pending = pre;
      pre.onload = () => {
        if (pending !== pre) return;
        pending = null;
        if (reduce.matches || lightNet) return;
        img.dataset.mode = 'anim';
        img.srcset = '';
        img.src = animSrc;
        btn.textContent = '暂停动作';
        btn.setAttribute('aria-pressed', 'true');
        fig.dataset.anim = 'on';
      };
      pre.onerror = () => { if (pending === pre) { animFailed = true; showStatic(); } };
      pre.src = animSrc;
    };
    img.addEventListener('error', () => {
      if (img.dataset.mode === 'anim') { animFailed = true; showStatic(); }
    });

    showStatic();
    btn.hidden = reduce.matches || lightNet;
    // 不自动播放：只有用户点过"播放"（stored 为 playing）才换图。
    if (!btn.hidden && !weakNet && stored === 'playing') showAnim();

    btn.addEventListener('click', () => {
      if (img.dataset.mode === 'anim' || pending) {
        showStatic();
        stored = 'paused';
      } else {
        stored = 'playing';
        showAnim();
      }
      try { window.localStorage.setItem('yuheng-motion', stored); } catch { /* 隐私模式下忽略 */ }
    });

    reduce.addEventListener('change', () => {
      btn.hidden = reduce.matches || lightNet;
      if (reduce.matches) showStatic();
    });
  }
</script>

<style>
  .yuheng {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .yuheng-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
  }
  /* 柔和落影：与暖纸底的接触感，避免模型"浮空" */
  .yuheng-frame::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 3%;
    width: 58%;
    height: 6%;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(52, 74, 60, 0.26) 0%, rgba(52, 74, 60, 0.12) 45%, transparent 72%);
    filter: blur(10px);
    z-index: 0;
    pointer-events: none;
  }
  .yuheng-art {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 20px 44px rgba(45, 66, 52, 0.18));
  }
  .yuheng-caption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    text-align: center;
  }
  .yuheng-caption-main {
    font: 12px/1.5 ui-monospace, monospace;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #4b6155;
  }
  .yuheng-caption-sub {
    font-family: "Songti SC", "Noto Serif CJK SC", SimSun, serif;
    font-size: 15px;
    letter-spacing: 0.18em;
    color: #3b4d42;
  }
  .yuheng-toggle {
    margin-top: 0.4rem;
    min-height: 44px;
    padding: 0 0.85rem;
    border: 1px solid rgba(52, 74, 60, 0.45);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: #33463b;
    font: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    cursor: pointer;
  }
  .yuheng-toggle:hover { border-color: rgba(52, 74, 60, 0.5); }
  .yuheng-toggle:focus-visible { outline: 2px solid #7a5b2e; outline-offset: 3px; }
</style>
