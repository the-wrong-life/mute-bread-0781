---
interface Props {
  src?: string;
  srcSet?: string;
  alt: string;
  caption?: string;
  /** 循环动画素材；留空则不提供动起来的能力。 */
  animSrc?: string;
}
const {
  src = '/yuheng/yuheng-core.webp',
  srcSet = '/yuheng/yuheng-core-520.webp 520w, /yuheng/yuheng-core.webp 1040w',
  alt,
  caption = 'NOVA CORE · 玉衡',
  animSrc = '/yuheng/yuheng-loop.webp',
} = Astro.props;
---

<figure class="yuheng" data-yuheng data-static-src={src} data-anim-src={animSrc}>
  <div class="yuheng-frame">
    <img
      class="yuheng-art"
      src={src}
      srcset={srcSet}
      sizes="(max-width: 768px) 88vw, min(37.5rem, 46vw)"
      width="1040"
      height="1040"
      alt={alt}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
  <figcaption class="yuheng-caption">
    <span>{caption}</span>
    <button class="yuheng-toggle" type="button" hidden aria-pressed="false">暂停动作</button>
  </figcaption>
</figure>

<script>
  // 静态图负责 LCP；动画素材在首屏稳定后按需换上，可暂停，尊重 prefers-reduced-motion 与省流量设置。
  const figures = Array.from(document.querySelectorAll<HTMLElement>('[data-yuheng]'));
  for (const fig of figures) {
    const img = fig.querySelector<HTMLImageElement>('.yuheng-art');
    const btn = fig.querySelector<HTMLButtonElement>('.yuheng-toggle');
    const staticSrc = fig.dataset.staticSrc || '';
    const animSrc = fig.dataset.animSrc || '';
    if (!img || !btn || !staticSrc || !animSrc) continue;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const conn = (navigator as unknown as { connection?: { saveData?: boolean; effectiveType?: string; downlink?: number } }).connection;
    // 动画素材现为 16 帧摆动版约 197 KiB；3G（1.6 Mbps）仍需 1 秒以上，一并按"省流量"处理
    const lightNet = conn?.saveData === true || /(^|-)2g$|(^|-)3g$/.test(conn?.effectiveType || '');
    // 原生实测：ESA 边缘到客户端约 40 KB/s 时，396 KB 动图要 10 s 以上才换得上来，
    // 因此把"下行 < 1 Mbps"也视为弱网：不自动播放，但保留"播放动作"按钮由用户决定。
    const slowLink = typeof conn?.downlink === 'number' && conn.downlink < 1;
    const weakNet = lightNet || slowLink;
    let stored = (() => {
      try { return window.localStorage.getItem('yuheng-motion'); } catch { return null; }
    })();

    const staticSrcSet = img.getAttribute('srcset') || '';
    let pending: HTMLImageElement | null = null;
    // 动图请求失败过一次后不再重试：否则每次点击都会重新发出一次注定失败的请求
    let animFailed = false;
    const cancelLoad = () => {
      if (!pending) return;
      pending.onload = null;
      pending.onerror = null;
      pending.src = '';
      pending = null;
    };
    const showStatic = () => {
      cancelLoad();
      img.dataset.mode = 'static';
      img.srcset = staticSrcSet;
      img.src = staticSrc;
      btn.textContent = '播放动作';
      btn.setAttribute('aria-pressed', 'false');
      fig.dataset.anim = 'off';
    };
    const showAnim = () => {
      if (reduce.matches || lightNet || img.dataset.mode === 'anim' || pending) return;
      if (animFailed) { showStatic(); return; }
      const pre = new Image();
      pending = pre;
      pre.onload = () => {
        if (pending !== pre) return;
        pending = null;
        if (reduce.matches || lightNet) return;
        img.dataset.mode = 'anim';
        img.srcset = '';
        img.src = animSrc;
        btn.textContent = '暂停动作';
        btn.setAttribute('aria-pressed', 'true');
        fig.dataset.anim = 'on';
      };
      pre.onerror = () => { if (pending === pre) { animFailed = true; showStatic(); } };
      pre.src = animSrc;
    };
    img.addEventListener('error', () => {
      if (img.dataset.mode === 'anim') { animFailed = true; showStatic(); }
    });

    showStatic();
    const wide = window.matchMedia('(min-width: 900px)');
    btn.hidden = reduce.matches || lightNet;
    if (!btn.hidden && !weakNet && wide.matches && stored !== 'paused') showAnim();

    btn.addEventListener('click', () => {
      if (img.dataset.mode === 'anim' || pending) {
        showStatic();
        stored = 'paused';
      } else {
        stored = 'playing';
        showAnim();
      }
      try { window.localStorage.setItem('yuheng-motion', stored); } catch { /* 隐私模式下忽略 */ }
    });

    reduce.addEventListener('change', () => {
      btn.hidden = reduce.matches || lightNet;
      if (reduce.matches) showStatic();
    });
  }
</script>

<style>
  .yuheng {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }
  .yuheng-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
  }
  /* 柔和落影：与暖白纸底的接触感，避免模型"浮空" */
  .yuheng-frame::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 4%;
    width: 62%;
    height: 7%;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(52, 74, 60, 0.30) 0%, rgba(52, 74, 60, 0.14) 45%, transparent 72%);
    filter: blur(10px);
    z-index: 0;
    pointer-events: none;
  }
  .yuheng-art {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 22px 46px rgba(45, 66, 52, 0.20));
    animation: yuheng-float 14s ease-in-out infinite;
    will-change: transform;
  }
  @keyframes yuheng-float {
    0%, 100% { transform: translateY(0) }
    50% { transform: translateY(-0.55rem) }
  }
  @media (prefers-reduced-motion: reduce) {
    .yuheng-art { animation: none; }
  }
  .yuheng[data-anim] .yuheng-art { animation: none; }
  .yuheng-caption {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    /* #f5f1e8 底上 5.4:1，满足正文对比度；旧的 #6d7c72 只有约 3.7:1 */
    color: #57665c;
  }
  .yuheng-toggle {
    min-height: 44px;
    padding: 0 0.85rem;
    border: 1px solid rgba(52, 74, 60, 0.45);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: #33463b;
    font: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    cursor: pointer;
  }
  .yuheng-toggle:hover { border-color: rgba(52, 74, 60, 0.5); }
  .yuheng-toggle:focus-visible { outline: 2px solid #7a5b2e; outline-offset: 3px; }
</style>