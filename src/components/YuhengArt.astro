---
interface Props {
  src?: string;
  srcSet?: string;
  alt: string;
  caption?: string;
  /** 循环动画素材；留空则不提供动起来的能力。 */
  animSrc?: string;
}
const {
  src = '/yuheng/yuheng-core.webp',
  srcSet = '/yuheng/yuheng-core-520.webp 520w, /yuheng/yuheng-core.webp 1040w',
  alt,
  caption = 'NOVA CORE · 玉衡',
  animSrc = '/yuheng/yuheng-loop.webp',
} = Astro.props;
---

<figure class="yuheng" data-yuheng data-static-src={src} data-anim-src={animSrc}>
  <div class="yuheng-frame">
    <img
      class="yuheng-art"
      src={src}
      srcset={srcSet}
      sizes="(max-width: 768px) 88vw, min(37.5rem, 46vw)"
      width="1040"
      height="1040"
      alt={alt}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
  <figcaption class="yuheng-caption">
    <span>{caption}</span>
    <button class="yuheng-toggle" type="button" hidden aria-pressed="false">暂停动作</button>
  </figcaption>
</figure>

<script>
  // 静态图负责 LCP；动画素材在首屏稳定后按需换上，可暂停，尊重 prefers-reduced-motion 与省流量设置。
  const IDLE = (cb: () => void) => {
    const ric = (window as unknown as { requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => number }).requestIdleCallback;
    if (ric) ric(cb, { timeout: 2500 });
    else window.setTimeout(cb, 1200);
  };

  const figures = Array.from(document.querySelectorAll<HTMLElement>('[data-yuheng]'));
  for (const fig of figures) {
    const img = fig.querySelector<HTMLImageElement>('.yuheng-art');
    const btn = fig.querySelector<HTMLButtonElement>('.yuheng-toggle');
    const staticSrc = fig.dataset.staticSrc || '';
    const animSrc = fig.dataset.animSrc || '';
    if (!img || !btn || !staticSrc || !animSrc) continue;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const conn = (navigator as unknown as { connection?: { saveData?: boolean; effectiveType?: string; downlink?: number } }).connection;
    // 动画素材现为 16 帧摆动版约 197 KiB；3G（1.6 Mbps）仍需 1 秒以上，一并按"省流量"处理
    const lightNet = conn?.saveData === true || /(^|-)2g$|(^|-)3g$/.test(conn?.effectiveType || '');
    // 原生实测：ESA 边缘到客户端约 40 KB/s 时，396 KB 动图要 10 s 以上才换得上来，
    // 因此把"下行 < 1 Mbps"也视为弱网：不自动播放，但保留"播放动作"按钮由用户决定。
    const slowLink = typeof conn?.downlink === 'number' && conn.downlink < 1;
    const weakNet = lightNet || slowLink;
    let stored = (() => {
      try { return window.localStorage.getItem('yuheng-motion'); } catch { return null; }
    })();

    const showStatic = () => {
      if (img.dataset.mode === 'static') return;
      img.dataset.mode = 'static';
      img.src = staticSrc;
      img.srcset = '';
      btn.textContent = '播放动作';
      btn.setAttribute('aria-pressed', 'false');
      fig.dataset.anim = 'off';
    };
    const showAnim = () => {
      if (img.dataset.mode === 'anim') return;
      img.dataset.mode = 'anim';
      img.srcset = '';
      img.src = animSrc;
      btn.textContent = '暂停动作';
      btn.setAttribute('aria-pressed', 'true');
      fig.dataset.anim = 'on';
    };

    const allowed = () => !reduce.matches && !weakNet && stored !== 'paused';

    // 上次手动暂停过：直接以静态态呈现，按钮文案与状态必须一致，不能只留默认文案
    if (stored === 'paused') showStatic();
    // 弱网/省流量时不自动播放，也要把按钮文案同步成"播放动作"
    else if (weakNet || reduce.matches) showStatic();

    // 只有在"省流量/2G/3G"时彻底不提供切换按钮；仅下行偏慢（<1 Mbps）时保留按钮，让用户自己决定要不要看动画。
    const wide = window.matchMedia('(min-width: 900px)');
    btn.hidden = reduce.matches || lightNet;
    if (!btn.hidden && !weakNet && wide.matches) {
      // 宽屏下立即开始取，让动画图尽早成为 LCP 候选，而不是等 idle 之后才发起请求。
      const pre = new Image();
      pre.fetchPriority = 'high';
      pre.onload = () => { if (allowed()) showAnim(); };
      pre.src = animSrc;
    }

    btn.addEventListener('click', () => {
      const playing = img.dataset.mode === 'anim';
      if (playing) {
        showStatic();
        stored = 'paused';
        try { window.localStorage.setItem('yuheng-motion', 'paused'); } catch { /* 隐私模式下忽略 */ }
      } else {
        showAnim();
        stored = 'playing';
        try { window.localStorage.setItem('yuheng-motion', 'playing'); } catch { /* 隐私模式下忽略 */ }
      }
    });

    reduce.addEventListener('change', () => { if (reduce.matches) showStatic(); });
  }
</script>

<style>
  .yuheng {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }
  .yuheng-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
  }
  /* 柔和落影：与暖白纸底的接触感，避免模型"浮空" */
  .yuheng-frame::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 4%;
    width: 62%;
    height: 7%;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(52, 74, 60, 0.30) 0%, rgba(52, 74, 60, 0.14) 45%, transparent 72%);
    filter: blur(10px);
    z-index: 0;
    pointer-events: none;
  }
  .yuheng-art {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 22px 46px rgba(45, 66, 52, 0.20));
    animation: yuheng-float 14s ease-in-out infinite;
    will-change: transform;
  }
  @keyframes yuheng-float {
    0%, 100% { transform: translateY(0) }
    50% { transform: translateY(-0.55rem) }
  }
  @media (prefers-reduced-motion: reduce) {
    .yuheng-art { animation: none; }
  }
  .yuheng[data-anim='on'] .yuheng-art { animation: none; }
  .yuheng-caption {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    /* #f5f1e8 底上 5.4:1，满足正文对比度；旧的 #6d7c72 只有约 3.7:1 */
    color: #57665c;
  }
  .yuheng-toggle {
    min-height: 44px;
    padding: 0 0.85rem;
    border: 1px solid rgba(52, 74, 60, 0.45);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: #33463b;
    font: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    cursor: pointer;
  }
  .yuheng-toggle:hover { border-color: rgba(52, 74, 60, 0.5); }
  .yuheng-toggle:focus-visible { outline: 2px solid #7a5b2e; outline-offset: 3px; }
</style>