---
interface Props { height?: string }
const { height = 'min(78vh, 640px)' } = Astro.props;
---
<div class="jade-viewer" data-jade-viewer style={'--viewer-h:' + height}>
  <canvas aria-label="玉衡三维模型：可拖动旋转、滚轮缩放" role="img"></canvas>
  <p class="jade-status" data-jade-status role="status">正在载入三维模型…</p>
  <noscript><p class="jade-fallback">需要启用 JavaScript 才能查看三维玉衡。下方提供静态说明。</p></noscript>
</div>
<style>
  .jade-viewer{position:relative;width:100%;height:var(--viewer-h);min-height:320px;border:1px solid #cfc6b5;border-radius:2px;background:radial-gradient(ellipse at 50% 38%,#1d2b25 0%,#141c18 55%,#0e1411 100%);overflow:hidden;touch-action:none}
  .jade-viewer canvas{display:block;width:100%;height:100%}
  .jade-status{position:absolute;left:0;right:0;bottom:0;margin:0;padding:8px 12px;color:#c9d8c9;background:linear-gradient(transparent,rgba(10,16,13,.72));font:11px ui-monospace,monospace;letter-spacing:.08em;pointer-events:none}
  .jade-viewer[data-renderer="ready"] .jade-status{opacity:0;transition:opacity .4s}
  .jade-viewer[data-renderer="failed"]{background:#141c18}
  .jade-fallback{position:absolute;inset:auto 16px 16px;color:#e8dcc0;font-size:13px;line-height:1.7}
</style>
<script>
  import { mountJadeViewer } from '../scripts/jade/viewer';
  const root = document.querySelector<HTMLElement>('[data-jade-viewer]');
  const status = root?.querySelector<HTMLElement>('[data-jade-status]');
  if (root && status) {
    const handle = mountJadeViewer(root);
    if (!handle) {
      root.dataset.renderer = 'failed';
      status.textContent = '当前浏览器无法创建 WebGL 上下文，已保留静态说明。';
    } else {
      status.textContent = '';
      (window as unknown as { __jadeViewer?: unknown }).__jadeViewer = handle;
    }
  }
</script>
