---
import NovaShell from '../layouts/NovaShell.astro';
import NovaCore from '../components/NovaCore.astro';
---
<NovaShell title="格物致知 · 造物有成" description="DIY 工程实验室：以工程实验把想法推进到现实。">
  <section class="hero">
    <div class="intro">
      <p class="eyebrow">PROJECT NOVA / 01</p>
      <h1>格物<br /><em>致知</em><br />造物有成<span>。</span></h1>
      <p class="lede">以工程为尺，以实验为证。记录假设，制作原型，让想法在可复现的测试中落地。</p>
      <p class="subline">ENGINEERING IDEAS INTO REALITY</p>
      <a class="enter" href="/projects">进入实验室 <span aria-hidden="true">↗</span></a>
    </div>
    <div class="core-stage"><NovaCore size="min(100%, 30rem)" label="NOVA Core：实验室核心视觉" /><p class="core-caption"><span>NOVA CORE</span><span>OPTICAL FIELD / ONLINE</span></p></div>
    <nav class="domains" aria-label="工程领域入口"><p class="eyebrow">DOMAINS</p><a href="/projects">船舶电气 <span>01</span></a><a href="/projects">机械设计 <span>02</span></a><a href="/ai">AI 工程 <span>03</span></a><a href="/tools">工程工具 <span>04</span></a></nav>
  </section>
  <section class="signal" aria-label="实验室状态"><span>RESEARCH / OPEN</span><span>STATIC-FIRST / ASTRO</span><span>WEBGL / GRACEFUL FALLBACK</span></section>
</NovaShell>
<style>
:global(body){background:#f4f0e6;color:#252922}
.hero{min-height:calc(100vh - 92px);max-width:1440px;margin:auto;display:grid;grid-template-columns:minmax(220px,1fr) minmax(320px,1.25fr) minmax(180px,.7fr);align-items:center;gap:clamp(22px,4vw,68px);padding:clamp(36px,6vw,88px) clamp(20px,5vw,72px)}
.intro{position:relative;z-index:1}.eyebrow{color:#a13a2e;font:11px ui-monospace,monospace;letter-spacing:.16em}.intro h1{margin:26px 0 30px;color:#252922;font-size:clamp(44px,5vw,78px);line-height:.98;font-weight:500}.intro h1 em{color:#587b6c;font-style:normal}.intro h1 span{color:#a13a2e}.lede{max-width:360px;color:#66665c;font-size:14px;line-height:1.9}.subline{margin:18px 0 0;color:#8b8579;font:10px ui-monospace,monospace;letter-spacing:.12em}.enter{display:inline-flex;gap:30px;margin-top:28px;padding:13px 0;color:#34372f;text-decoration:none;border-bottom:1px solid #a13a2e;font:12px ui-monospace,monospace;letter-spacing:.08em}.enter span{color:#a13a2e;font-size:17px}.enter:focus-visible,.domains a:focus-visible{outline:2px solid #587b6c;outline-offset:4px}
.core-stage{position:relative;display:grid;place-items:center;min-width:0;width:100%;filter:saturate(.7)}.core-caption{position:absolute;bottom:2%;left:50%;width:min(100%,30rem);transform:translateX(-50%);display:flex;justify-content:space-between;gap:12px;color:#77776b;font:10px ui-monospace,monospace;letter-spacing:.08em}
.domains{display:flex;flex-direction:column}.domains .eyebrow{margin-bottom:24px}.domains a{display:flex;justify-content:space-between;gap:12px;padding:16px 0;border-bottom:1px solid #d6d0c2;color:#404238;text-decoration:none;font-size:13px;transition:color .18s,border-color .18s}.domains a:hover{color:#a13a2e;border-color:#a13a2e}.domains span{color:#858276;font:10px ui-monospace,monospace}
.signal{display:flex;justify-content:space-between;gap:14px;max-width:1440px;margin:auto;padding:18px clamp(20px,5vw,72px) 28px;color:#77776b;font:10px ui-monospace,monospace;letter-spacing:.08em;border-top:1px solid #ded8cb}
@media(max-width:900px){.hero{grid-template-columns:minmax(0,1fr) minmax(0,1fr);min-height:auto;padding-top:64px}.core-stage{grid-column:2;grid-row:1 / span 2}.domains{grid-column:1}.signal{flex-wrap:wrap}}
@media(max-width:620px){.hero{display:flex;flex-direction:column;align-items:stretch;gap:24px;padding:48px 22px 34px}.intro h1{font-size:clamp(42px,12vw,62px);margin:20px 0}.core-stage{order:2;max-width:30rem;align-self:center}.core-caption{font-size:9px}.domains{order:3}.domains .eyebrow{margin:0 0 10px}.domains a{padding:13px 0}.signal{padding:16px 22px 24px;flex-direction:column;align-items:flex-start;gap:9px}}
@media(prefers-reduced-motion:reduce){.domains a{transition:none}}
</style>
