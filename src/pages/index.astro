---
import NovaShell from '../layouts/NovaShell.astro';
import NovaCore from '../components/NovaCore.astro';
---
<NovaShell title="格物致知 · 造物有成" description="DIY 工程实验室：以工程方法探索想法，让创造有迹可循。">
  <div class="page">
    <section class="hero" aria-label="DIY 工程实验室首页">
      <div class="intro"><p class="eyebrow">PROJECT NOVA · 工程实验室</p><h1>格物致知<br />造物有成</h1><p class="english">Engineering Ideas Into Reality</p><p class="lede">以工程方法探索想法<br />让每一次创造都有迹可循</p><a class="enter" href="/projects">进入实验室 <span aria-hidden="true">→</span></a><p class="motto"><span aria-hidden="true"></span>探索 · 验证 · 创造</p></div>
      <div class="core-stage"><NovaCore size="min(100%, 38rem)" label="NOVA Core：玉衡核心装置" /><div class="core-caption"><span>NOVA CORE · 玉衡</span><span>生生不息 · 求知无尽</span></div></div>
      <nav class="domains" aria-label="工程领域入口"><p class="domains-title">探索领域 <span aria-hidden="true"></span></p><a href="/projects"><small>01</small><span>船舶电气</span><b aria-hidden="true">→</b></a><a href="/projects"><small>02</small><span>机械设计</span><b aria-hidden="true">→</b></a><a href="/ai"><small>03</small><span>AI 工程</span><b aria-hidden="true">→</b></a><a href="/tools"><small>04</small><span>工程工具</span><b aria-hidden="true">→</b></a></nav>
    </section>
    <nav class="quick-links" aria-label="常用入口"><div class="quick-heading"><strong>从想法，到现实</strong><span>EXPLORE THE LAB</span></div><a href="/projects"><span aria-hidden="true">⌘</span>项目中心 <b aria-hidden="true">→</b></a><a href="/docs"><span aria-hidden="true">▤</span>工程知识库 <b aria-hidden="true">→</b></a><a href="/tools"><span aria-hidden="true">⌖</span>工程工具箱 <b aria-hidden="true">→</b></a></nav>
  </div>
</NovaShell>
<style>
:global(body){background:#f4f0e6;color:#202923}.page{max-width:1440px;margin:auto;padding:0 clamp(20px,3.7vw,58px)}.hero{position:relative;min-height:min(690px,calc(100vh - 80px));display:grid;grid-template-columns:minmax(280px,.95fr) minmax(400px,1.65fr) minmax(250px,.95fr);align-items:center;gap:clamp(18px,2.5vw,38px);padding:24px 0 54px}.intro{position:relative;z-index:1;min-width:0}.eyebrow{margin:0 0 22px;color:#272b25;font:600 12px ui-monospace,monospace;letter-spacing:.12em}.eyebrow:after{content:"";display:block;width:38px;height:3px;margin-top:18px;background:#a74432}.intro h1{margin:0;color:#1e2924;font-family:Georgia,"Noto Serif CJK SC","Songti SC",serif;font-size:clamp(44px,4.8vw,76px);font-weight:600;line-height:1.26;white-space:nowrap}.english{margin:14px 0 18px;color:#32362f;font:italic 15px Georgia,serif;letter-spacing:.11em;white-space:nowrap}.lede{margin:0 0 24px;color:#383a32;font-family:"Noto Serif CJK SC","Songti SC",serif;font-size:17px;line-height:1.75}.enter{min-height:44px;display:inline-flex;align-items:center;justify-content:space-between;gap:28px;min-width:220px;padding:12px 18px;background:#a74432;border:1px solid #a74432;color:#fffaf0;text-decoration:none;font-family:"Noto Serif CJK SC","Songti SC",serif;font-size:18px;transition:background .18s,border-color .18s}.enter:hover{background:#873a2d;border-color:#873a2d}.enter span{font:24px/1 Arial,sans-serif}.enter:focus-visible,.domains a:focus-visible,.quick-links a:focus-visible{outline:2px solid #52735e;outline-offset:4px}.motto{display:flex;align-items:center;gap:14px;margin:26px 0 0;color:#34372f;font-family:"Noto Serif CJK SC","Songti SC",serif;font-size:14px;letter-spacing:.12em}.motto span{width:36px;height:1px;background:#a74432}
.core-stage{position:relative;display:grid;place-items:center;min-width:0;width:100%;align-self:stretch;padding:8px 0 44px}.core-stage :global(.nova-core){width:min(100%,38rem)!important;max-width:100%}.core-caption{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);width:min(100%,25rem);display:flex;flex-direction:column;align-items:center;gap:5px;text-align:center;color:#262a24;font-family:"Noto Serif CJK SC","Songti SC",serif;font-size:13px;letter-spacing:.18em;white-space:nowrap}.domains{min-width:0;display:flex;flex-direction:column;align-self:center}.domains-title{display:flex;align-items:center;gap:14px;margin:0 0 20px;color:#242820;font-family:"Noto Serif CJK SC","Songti SC",serif;font-size:19px;letter-spacing:.16em}.domains-title span{width:34px;height:1px;background:#a74432}.domains a{display:grid;grid-template-columns:42px minmax(0,1fr) 24px;align-items:center;gap:14px;min-width:0;padding:18px 0;border-bottom:1px solid #d4cbbb;color:#242820;text-decoration:none;font-family:"Noto Serif CJK SC","Songti SC",serif;font-size:clamp(17px,1.55vw,23px);transition:color .18s,border-color .18s}.domains a:hover{color:#a74432;border-color:#a74432}.domains small{color:#3c5143;font:15px Georgia,serif;letter-spacing:.08em}.domains b{font:22px Arial,sans-serif;font-weight:400}.quick-links{display:grid;grid-template-columns:1.05fr repeat(3,1fr);align-items:center;border-top:1px solid #d5cebf;padding:22px 0 25px}.quick-heading{display:flex;flex-direction:column;gap:5px;border-left:4px solid #a74432;padding-left:16px;color:#202923}.quick-heading strong{font-family:"Noto Serif CJK SC","Songti SC",serif;font-size:24px;font-weight:500}.quick-heading span{font:10px ui-monospace,monospace;letter-spacing:.2em}.quick-links a{display:flex;align-items:center;justify-content:center;gap:12px;min-width:0;padding:9px 12px;border-left:1px solid #d5cebf;color:#252a23;text-decoration:none;font-family:"Noto Serif CJK SC","Songti SC",serif;font-size:19px;white-space:nowrap}.quick-links a>span{color:#3f604c;font-size:26px}.quick-links a b{font:20px Arial,sans-serif;font-weight:400}.quick-links a:hover{color:#a74432}
@media(max-width:1100px) and (min-width:701px){.hero{grid-template-columns:minmax(220px,.9fr) minmax(320px,1.3fr);grid-template-rows:auto auto;min-height:0;gap:16px 28px;padding:34px 0 42px}.core-stage{grid-column:2;grid-row:1 / span 2;min-height:530px}.domains{grid-column:1;grid-row:2}.quick-links{grid-template-columns:1fr 1fr}.quick-heading{grid-column:1/-1;padding:0 0 14px;border:0;border-bottom:1px solid #d5cebf;margin-bottom:8px}.quick-links a:nth-of-type(2){border-left:0}}
@media(max-width:700px){.page{padding:0 18px}.hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);grid-template-rows:auto auto;gap:4px 10px;min-height:0;padding:18px 0 16px}.intro{grid-column:1;grid-row:1;align-self:center}.eyebrow{font-size:9px;letter-spacing:.04em;margin-bottom:10px}.eyebrow:after{margin-top:9px;width:28px}.intro h1{font-size:clamp(26px,7.2vw,44px);line-height:1.22}.english{font-size:9px;letter-spacing:.015em;margin:7px 0 9px;white-space:normal}.lede{font-size:12px;line-height:1.6;margin:0 0 11px}.enter{min-width:0;width:100%;max-width:190px;padding:9px 11px;gap:9px;font-size:14px}.enter span{font-size:20px}.motto{display:none}.core-stage{grid-column:2;grid-row:1;align-self:center;padding:0 0 29px}.core-stage :global(.nova-core){width:min(46vw,240px)!important;max-width:100%}.core-caption{bottom:0;width:100%;font-size:10px;letter-spacing:.04em;gap:3px}.domains{grid-column:1/-1;grid-row:2;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:8px}.domains-title{grid-column:1/-1;font-size:14px;margin:0 0 2px}.domains-title span{width:22px}.domains a{display:flex;flex-direction:column;align-items:flex-start;gap:3px;padding:7px 0 8px;font-size:11px;border-bottom:1px solid #d4cbbb}.domains small{font-size:10px}.domains b{display:none}.quick-links{grid-template-columns:repeat(3,minmax(0,1fr));padding:11px 0 14px}.quick-heading{grid-column:1/-1;flex-direction:row;align-items:baseline;justify-content:space-between;border-left:3px solid #a74432;padding:0 0 7px 9px;margin-bottom:4px}.quick-heading strong{font-size:15px}.quick-heading span{font-size:8px;letter-spacing:.08em}.quick-links a{flex-direction:column;gap:2px;padding:7px 2px;border-left:1px solid #d5cebf;font-size:12px;white-space:normal;text-align:center}.quick-links a:nth-of-type(2){border-left:0}.quick-links a>span{font-size:18px}.quick-links a b{font-size:14px}}
@media(max-width:380px){.page{padding-inline:14px}.hero{column-gap:6px}.intro h1{font-size:26px}.english{font-size:8px}.lede{font-size:11px}.enter{padding:8px;font-size:12px}.core-stage :global(.nova-core){width:min(45vw,210px)!important}.domains{gap:5px}.domains a{font-size:11px}.english{font-size:9px}.lede{font-size:12px}}
@media(prefers-reduced-motion:reduce){.enter,.domains a{transition:none}}
</style>
