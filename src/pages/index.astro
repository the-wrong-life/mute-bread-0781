---
import NovaShell from '../layouts/NovaShell.astro';
import YuhengArt from '../components/YuhengArt.astro';
import { projects as allProjects } from '../data/projects';
import { docs as allDocs } from '../data/docs';

const domains = [
  { number: '01', title: '船舶电气', href: '/marine/' },
  { number: '02', title: '机械设计', href: '/mechanical/' },
  { number: '03', title: 'AI 工程', href: '/ai/' },
  { number: '04', title: '工程工具', href: '/tools/' },
];
// 首页只引用真实存在的档案，避免出现"待补充"占位卡片
const projects = allProjects.slice(0, 3).map((item) => ({
  title: item.title,
  note: item.domain + ' · ' + item.status,
  href: '/projects/' + item.slug + '/',
}));
const documents = allDocs.slice(0, 3).map((item) => ({
  title: item.title,
  note: item.kind + ' · 更新于 ' + item.updated,
  href: '/docs/' + item.slug + '/',
}));
const journals = [
  { title: '研究日志', note: '按提交记录整理', href: '/blog/' },
  { title: '从想法到实验', note: '方法笔记', href: '/blog/' },
];
---

<NovaShell title="格物致知 · 造物有成" description="DIY 工程实验室：以工程方法探索想法，让创造有迹可循。" active="/">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-grid">
      <div class="hero-intro">
        <p class="eyebrow">PROJECT NOVA · 工程实验室</p>
        <h1 id="hero-title">格物致知<br />造物有成</h1>
        <p class="english" lang="en">Engineering Ideas Into Reality</p>
      </div>
      <div class="core-stage">
        <div class="core-breath">
          <YuhengArt alt="玉衡：青玉球体、金铜衔尾蛇环与倾斜的铜金测量环" />
        </div>
      </div>
      <p class="hero-lede">以工程方法探索想法，让每一次创造都有迹可循。</p>
      <a class="button primary" href="/projects/">进入实验室 <span aria-hidden="true">→</span></a>
      <div class="hero-side">
        <p class="eyebrow">探索领域 / 01</p>
        <nav class="domains" aria-label="工程领域入口">
        {domains.map((domain) => <a href={domain.href}><span class="number">{domain.number}</span><span>{domain.title}</span><span class="arrow" aria-hidden="true">↗</span></a>)}
        </nav>
      </div>
    </div>
  </section>

  <div class="paper">

    <section class="section" aria-labelledby="projects-title">
      <div class="section-heading">
        <div><p class="eyebrow">项目档案 / 02</p><h2 id="projects-title">项目精选</h2></div>
        <p>已建立的档案，含问题、方法与未完成事项。</p>
      </div>
      <div class="cards three">
        {projects.map((item, i) => <a class="card" href={item.href}><span class="number">0{i + 1} / 项目中心</span><span class="card-title">{item.title}</span><span class="card-bottom">{item.note}<span aria-hidden="true">↗</span></span></a>)}
      </div>
    </section>

    <section class="section" aria-labelledby="docs-title">
      <div class="section-heading">
        <div><p class="eyebrow">工程知识 / 03</p><h2 id="docs-title">工程知识库</h2></div>
        <p>已发布正文的条目，记录方法与边界条件。</p>
      </div>
      <div class="cards three">
        {documents.map((item, i) => <a class="card" href={item.href}><span class="number">0{i + 1} / 文档中心</span><span class="card-title">{item.title}</span><span class="card-bottom">{item.note}<span aria-hidden="true">↗</span></span></a>)}
      </div>
    </section>

    <section class="section" aria-labelledby="journal-title">
      <div class="section-heading">
        <div><p class="eyebrow">研究札记 / 04</p><h2 id="journal-title">研究日志</h2></div>
        <p>保留探索过程，也保留尚未解决的问题。</p>
      </div>
      <div class="cards two">
        {journals.map((item, i) => <a class="card" href={item.href}><span class="number">0{i + 1} / 研究札记</span><span class="card-title">{item.title}</span><span class="card-bottom">{item.note}<span aria-hidden="true">↗</span></span></a>)}
      </div>
    </section>

    <section class="section closing" aria-labelledby="closing-title">
      <p class="eyebrow">从想法，到现实</p>
      <h2 id="closing-title">让问题成为探索的起点。</h2>
      <a class="button primary" href="/projects/">进入项目中心 <span aria-hidden="true">→</span></a>
    </section>
  </div>
</NovaShell>

<style>
  :global(body) { background: #f4f0e6; color: #202923; }
  /* 首屏改用暖白纸底：玉衡的通透只在浅底上成立，
     深绿留给文字与朱砂做点缀，整体更接近参考图的"纸与玉"关系。 */
  .hero {
    --core-width: min(100%, 37.5rem);
    color: #1e2a23;
    background: radial-gradient(ellipse at 66% 38%, #fdfaf3 0%, #f7f2e7 32%, #f1ece0 66%, #eae3d4 100%);
    border-bottom: 1px solid #ded6c7;
  }
  .hero-grid {
    max-width: 1440px;
    min-height: min(740px, calc(100vh - 80px));
    margin: 0 auto;
    padding: 56px clamp(24px, 5vw, 72px) 64px;
    display: grid;
    grid-template-columns: minmax(270px, .9fr) minmax(0, 1.35fr);
    grid-template-rows: 1fr auto auto auto;
    grid-template-areas: "intro core" "lede core" "cta core" "side side";
    align-items: center;
    align-content: center;
    gap: 0 clamp(24px, 4vw, 64px);
  }
  .hero-intro { grid-area: intro; align-self: center; min-width: 0; }
  .eyebrow { margin: 0; color: #3f604c; font: 11px/1.5 ui-monospace, monospace; letter-spacing: .14em; overflow-wrap: anywhere; }
  /* §46：11px 小字对纸底 #ede5dd 的对比度原为 4.12–4.38（低于 WCAG AA 4.5），
     像素实测见 _work/nova-b-maint/night-audit-20261113.md。改用与项目页返回链接同档的
     #3f604c（实测约 5.6:1），色相不变。 */
  .hero .eyebrow { color: #3f604c; }
  h1, h2, .card-title, .domains a { font-family: "Songti SC", "Noto Serif CJK SC", SimSun, serif; }
  h1 { margin: 26px 0 15px; font-size: clamp(44px, 5vw, 76px); font-weight: 500; line-height: 1.2; }
  .english { margin: 0; color: #4d6b58; font: italic clamp(13px, 1.15vw, 17px)/1.5 Georgia, serif; letter-spacing: .06em; overflow-wrap: anywhere; }
  .hero-lede { grid-area: lede; align-self: start; max-width: 24rem; margin: 24px 0 0; color: #46564c; line-height: 1.8; overflow-wrap: anywhere; }
  .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 32px; min-height: 48px; padding: 12px 20px; text-decoration: none; font-family: "Songti SC", "Noto Serif CJK SC", SimSun, serif; }
  .primary { background: #a74432; color: #fffaf0; }
  .primary:hover { background: #873a2d; }
  .hero .button { grid-area: cta; justify-self: start; align-self: start; margin-top: 26px; min-width: 220px; }
  .hero-side { grid-area: side; min-width: 0; margin-top: 34px; }
  .hero-side .eyebrow { margin-bottom: 12px; }
  .side-note { display: none; }
  .core-stage { grid-area: core; display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 0; width: 100%; }
  .core-stage :global(.nova-shell) { max-width: 100%; }
  /* 静态主视觉的轻量呼吸：只做极小的位移与亮度起伏，
     不伪造三维运动；真正的旋转与蛇环动作在 /lab 实时视图里。 */
  .core-breath { width: 100%; animation: core-breath 9s ease-in-out infinite; will-change: transform; }
  @keyframes core-breath {
    0%, 100% { transform: translateY(0) scale(1); filter: brightness(1); }
    50% { transform: translateY(-6px) scale(1.008); filter: brightness(1.025); }
  }
  @media (prefers-reduced-motion: reduce) { .core-breath { animation: none; } }
  .core-stage :global(.hero-core) { aspect-ratio: 1 / 1; }


  .paper { background: #f4f0e6; }
  .section { max-width: 1440px; margin: 0 auto; padding: clamp(64px, 8vw, 124px) clamp(24px, 5vw, 72px); }
  .section + .section { border-top: 1px solid #d8d1c3; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 36px; }
  .section-heading > div, .section-heading > p { min-width: 0; }
  h2 { margin: 14px 0 0; font-size: clamp(32px, 3.5vw, 52px); line-height: 1.25; font-weight: 500; overflow-wrap: anywhere; }
  .section-heading > p { max-width: 27rem; margin: 0; color: #59645b; line-height: 1.7; overflow-wrap: anywhere; }
  .domains { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid #bcb5a7; }
  .domains a { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 16px; min-width: 0; min-height: 92px; padding: 16px 20px 16px 0; border-bottom: 1px solid #bcb5a7; color: #202923; font-size: clamp(17px, 1.5vw, 22px); text-decoration: none; overflow-wrap: anywhere; }
  .domains a + a { padding-left: 20px; border-left: 1px solid #d8d1c3; }
  .number { color: #3f604c; /* 渐变最暗端点下 4.14:1 -> 5.50:1（B 线 a11y-report.md） */ font: 11px/1.5 ui-monospace, monospace; letter-spacing: .05em; }
  .arrow, .card-bottom span { color: #7d5730; } /* 4.40:1 -> 4.88:1（B 线像素实测，见 _work/nova-b-maint/a11y-report.md） */
  .cards { display: grid; gap: 18px; }
  .three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .card { display: flex; flex-direction: column; min-width: 0; min-height: 190px; padding: 24px; border: 1px solid #cfc6b5; color: #202923; text-decoration: none; overflow-wrap: anywhere; }
  .card-title { margin: 36px 0 20px; font-size: 23px; }
  .card-bottom { display: flex; justify-content: space-between; gap: 16px; margin-top: auto; color: #59645b; font-size: 13px; }
  .domains a:hover, .card:hover { color: #3f604c; border-color: #8f6438; }
  .button:focus-visible, .domains a:focus-visible, .card:focus-visible { outline: 2px solid #b78b57; outline-offset: 4px; }
  .closing { padding-bottom: clamp(80px, 10vw, 150px); }
  .closing .button { margin-top: 30px; }
  /* 宽屏回到参考图的三段结构：左文案 / 中玉衡 / 右领域入口 */
  @media (min-width: 1200px) {
    .hero-grid {
      grid-template-columns: minmax(240px, .78fr) minmax(0, 1.3fr) minmax(172px, .40fr);
      grid-template-rows: auto auto auto;
      grid-template-areas: "intro core side" "lede core side" "cta core side";
    }
    .hero-side { align-self: end; margin-top: 0; padding-bottom: 6px; border-top: 1px solid #c9c1b1; }
    .hero-side .eyebrow { margin: 14px 0 4px; }
    .hero-side .domains { display: block; border-top: 0; }
    .hero-side .domains a { min-height: 66px; padding: 12px 0; border-left: 0; padding-left: 0; font-size: clamp(16px, 1.15vw, 19px); }
    .hero-side .domains a + a { border-left: 0; padding-left: 0; }
  }
  @media (max-width: 900px) and (min-width: 701px) {
    .hero-grid { grid-template-columns: minmax(240px, .9fr) minmax(0, 1.2fr); min-height: 580px; }
    .domains { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .domains a:nth-child(3) { padding-left: 0; border-left: 0; }
  }
  @media (max-width: 700px) {
    .hero { --core-width: min(88vw, 300px); }
    .hero-grid { min-height: 0; align-content: start; padding: 20px 20px 32px; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto; grid-template-areas: "intro" "lede" "core" "cta" "side"; gap: 0; }
    .hero-side { margin-top: 24px; }
    .hero-side .domains a { min-height: 52px; padding: 12px 0; }
    .hero-intro { align-self: auto; }
    .hero .eyebrow { font-size: 10px; }
    h1 { margin: 9px 0 5px; font-size: clamp(36px, 10vw, 40px); line-height: 1.16; }
    .english { font-size: 12px; }
    .core-stage { margin-top: 4px; }
    .core-caption { margin-top: 2px; font-size: 11px; }
    .hero .button { justify-self: stretch; min-width: 0; margin-top: 10px; }
    .hero-lede { margin-top: 12px; font-size: 13px; line-height: 1.6; }
    /* 移动端把导语放在标题下、CTA 之上，避免"按钮在前、说明在后"的阅读倒错 */
    .core-stage { order: 0; }
    .section { padding: 64px 20px; }
    .section-heading { display: block; margin-bottom: 24px; }
    .section-heading > p { margin-top: 12px; }
    .domains, .three, .two { grid-template-columns: minmax(0, 1fr); }
    .domains a, .domains a + a { min-height: 56px; padding: 14px 0; border-left: 0; }
    .card { min-height: 150px; padding: 20px; }
    .card-title { margin: 24px 0 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto; transition: none; }
  }
</style>