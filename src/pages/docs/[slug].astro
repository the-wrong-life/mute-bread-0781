---
import NovaShell from '../../layouts/NovaShell.astro';
import { docs } from '../../data/docs';
import type { Doc } from '../../data/docs';
interface Props {
  doc: Doc;
}
export function getStaticPaths() {
  return docs.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}
const { doc } = Astro.props;
---
<NovaShell title={doc.title} description={doc.summary} active="/docs">
  <article class="article">
    <a class="back" href="/docs">← 返回文档列表</a>
    <header><p class="eyebrow">知识库 / {doc.kind}</p><h1>{doc.title}</h1><p class="lead">{doc.summary}</p><p class="updated">更新于 <time datetime={doc.updated}>{doc.updated}</time></p></header>
    <nav class="toc" aria-label="本文目录"><h2>本文目录</h2><ol>{doc.sections.map((section, i) => <li><a href={`#section-${i + 1}`}>{section.heading}</a></li>)}</ol></nav>
    <div class="content">
      {doc.sections.map((section, i) => <section id={`section-${i + 1}`}><h2>{section.heading}</h2>{section.paragraphs.map((text) => <p>{text}</p>)}{section.math && <div class="math" set:html={section.math} />}{section.svg && <figure class="figure"><div class="figure-canvas" set:html={section.svg} />{section.svgCaption && <figcaption>{section.svgCaption}</figcaption>}</figure>}{section.list && <ul>{section.list.map((item) => <li>{item}</li>)}</ul>}{section.table && <div class="table-wrap"><table><thead><tr>{section.table.headers.map((cell) => <th scope="col">{cell}</th>)}</tr></thead><tbody>{section.table.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody></table></div>}{section.code && <pre><code>{section.code}</code></pre>}</section>)}
      <section class="sources"><h2>参考与说明</h2><ul>{doc.sources.map((source) => <li><strong>{source.label}：</strong>{source.note.startsWith('https://') ? <a href={source.note}>{source.note}</a> : source.note}</li>)}</ul></section>
      <section class="related"><h2>相关内容</h2><ul>{doc.related.map((item) => <li><a href={item.href}>{item.label} →</a></li>)}</ul></section>
    </div>
  </article>
</NovaShell>
<style>
.article{max-width:calc(68ch + 40px);margin:auto;padding:clamp(50px,8vw,90px) 20px;color:#202923;min-width:0;overflow-wrap:anywhere}.back{display:inline-flex;align-items:center;min-height:44px;color:#3f604c;text-decoration:none}.back:hover,.content a:hover,.toc a:hover{text-decoration-color:#a74432}.back:focus-visible,.article a:focus-visible{outline:2px solid #a74432;outline-offset:3px}header{padding:36px 0 30px}.eyebrow,.updated{font:12px/1.6 ui-monospace,monospace;color:#52735e;letter-spacing:.04em}h1,h2{font-family:"Songti SC","Noto Serif CJK SC",SimSun,serif;color:#202923}h1{font-size:clamp(36px,6vw,56px);line-height:1.25;margin:16px 0 20px}.lead{font-size:18px;line-height:1.8;color:#3f604c}.toc{padding:20px 24px;border-left:2px solid #a74432;background:#ece8dc}.toc h2{font-size:18px;margin:0}.toc ol{padding-left:1.4em;margin:8px 0 0}.toc li{line-height:1.5}.toc a{display:inline-flex;align-items:center;min-height:44px;color:#3f604c}.content{line-height:1.8;font-size:16px}.content section{padding-top:38px;scroll-margin-top:24px}.content h2{font-size:26px;line-height:1.4;margin:0 0 16px}.content p{margin:0 0 1em}.figure{margin:18px 0 1.4em;padding:16px 12px 12px;border:1px solid #d9d2c2;background:#f6f2e7;overflow-x:auto}.figure-canvas :global(svg){display:block;width:100%;max-width:480px;height:auto;margin:0 auto}.figure figcaption{margin-top:10px;font-size:14px;line-height:1.6;color:#52735e}.math{margin:0 0 1.2em;padding:6px 0;overflow-x:auto}.math :global(math){font-size:1.3em;color:#202923}.math :global(math[display="block"]){margin:.4em auto;text-align:center}.content ul{padding-left:1.5em}.content li{margin:.4em 0}.content a{color:#3f604c;overflow-wrap:anywhere}.table-wrap{overflow-x:auto;max-width:100%;margin:20px 0}table{border-collapse:collapse;width:100%;min-width:430px;text-align:left}th,td{padding:10px 12px;border:1px solid #b78b57;vertical-align:top}th{color:#3f604c;background:#ece8dc}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#ece8dc;border-left:2px solid #b78b57;padding:16px;line-height:1.7}code{font-family:ui-monospace,monospace;font-size:.9em}.related a{display:inline-flex;align-items:center;min-height:44px}.sources a{display:inline-block;min-height:44px;padding:10px 0}@media(max-width:600px){.article{padding-left:20px;padding-right:20px}.toc{padding:16px}.content h2{font-size:23px}}
</style>
