---
import NovaShell from '../layouts/NovaShell.astro';
import { docs } from '../data/docs';
---
<NovaShell title="工程文档" description="工程计算、资料整理与静态部署的参考文档。" active="/docs">
  <div class="page">
    <header class="intro"><p class="eyebrow">知识库 / 参考与方法</p><h1>工程文档<span>.</span></h1><p>从单位换算到部署记录，留下可复查的依据，也写清使用边界。</p></header>
    <section aria-label="文档列表" class="list">
      {docs.map((doc, i) => <article class="entry"><span class="number" aria-hidden="true">0{i + 1}</span><div class="body"><div class="meta"><span>{doc.kind}</span><time datetime={doc.updated}>更新于 {doc.updated}</time></div><h2><a href={`/docs/${doc.slug}`}>{doc.title}</a></h2><p>{doc.summary}</p></div><span class="arrow" aria-hidden="true">↗</span></article>)}
    </section>
  </div>
</NovaShell>
<style>
.page{max-width:1120px;margin:auto;padding:clamp(60px,10vw,120px) clamp(20px,5vw,72px);color:#202923;overflow-wrap:anywhere}.intro{max-width:70ch;margin-bottom:clamp(44px,7vw,80px)}.eyebrow,.meta,.number{font:12px/1.6 ui-monospace,monospace;letter-spacing:.08em;color:#52735e}.intro h1{font-family:"Songti SC","Noto Serif CJK SC",SimSun,serif;font-size:clamp(44px,7vw,80px);font-weight:600;line-height:1.15;margin:18px 0 22px}.intro h1 span{color:#a74432}.intro>p:last-child{font-size:17px;line-height:1.8;color:#3f604c}.entry{display:grid;grid-template-columns:48px minmax(0,1fr) 24px;gap:20px;padding:26px 0;border-top:1px solid #b78b57}.entry:last-child{border-bottom:1px solid #b78b57}.body{min-width:0}.number{padding-top:5px}.meta{display:flex;flex-wrap:wrap;gap:8px 20px}.body h2{font-family:"Songti SC","Noto Serif CJK SC",SimSun,serif;font-size:clamp(22px,3vw,29px);line-height:1.4;margin:10px 0}.body h2 a{display:inline-flex;align-items:center;min-height:44px;color:#202923;text-decoration:none}.body h2 a:hover{text-decoration:underline;text-decoration-color:#a74432;text-underline-offset:.25em}.body h2 a:focus-visible{outline:2px solid #a74432;outline-offset:4px}.body p{margin:0;max-width:68ch;line-height:1.8;color:#3f604c}.arrow{color:#8f6438}@media(max-width:600px){.entry{grid-template-columns:30px minmax(0,1fr);gap:12px}.arrow{display:none}}
</style>
