---
import NovaShell from '../layouts/NovaShell.astro';
const fields = [
  { title: '船舶电气', text: '关注供配电、控制与安全验证。' },
  { title: '机械设计', text: '关注结构、制造方法和工程约束。' },
  { title: '软件与 AI 工程', text: '关注软件实现、辅助研究及验证边界。' },
  { title: '工程工具', text: '关注可复用的小工具与清晰的使用范围。' },
];
---
<NovaShell title="关于" description="了解 DIY 工程实验室的方向与站点用途。" active="/about">
  <div class="page"><header class="intro"><p class="eyebrow">实验室 / 关于</p><h1>工程始于<br />可验证的想法。</h1><p>这里是整理工程想法、资料、方法与工具的站点。内容以可追溯的依据和明确的验证状态为原则，逐步完善。</p></header>
    <section aria-labelledby="fields-title"><h2 id="fields-title">关注领域</h2><div class="fields">{fields.map((field) => <article><h3>{field.title}</h3><p>{field.text}</p></article>)}</div></section>
    <section class="contents" aria-labelledby="contents-title"><h2 id="contents-title">站点内容</h2><ul><li><a href="/projects">项目</a><span>项目档案与资料逐步整理，具体状态请以项目页标注为准。</span></li><li><a href="/docs">文档</a><span>方法与参考资料持续整理，适用范围与资料来源请以各篇说明为准。</span></li><li><a href="/tools">工具</a><span>提供单位换算等工程辅助工具，使用前请留意页面所列限制。</span></li></ul></section>
    <aside class="note">站点资料和工具不替代设备手册、适用标准与专业判断。电气和机械相关应用应进行专业验证与现场验收。</aside>
  </div>
</NovaShell>
<style>
  .page{max-width:1120px;margin:auto;padding:clamp(64px,9vw,110px) clamp(20px,5vw,72px) 20px;overflow-wrap:anywhere}.intro{max-width:720px;margin-bottom:64px}.eyebrow{color:#52735e;font:12px ui-monospace,monospace;letter-spacing:.08em}h1{margin:20px 0 24px;font-size:clamp(36px,6vw,70px);line-height:1.2;font-weight:500}.intro>p:last-child{font-size:17px;color:#3f604c;line-height:1.8}h2{font-size:clamp(25px,3vw,34px);font-weight:500}h3{font-size:21px;font-weight:600;margin:0 0 10px}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:24px}.fields article{min-width:0;padding:24px;border:1px solid #b78b57;background:#faf7ef}.fields p{margin:0;color:#3f604c;line-height:1.8}.contents{margin-top:70px}.contents ul{list-style:none;margin:24px 0 0;padding:0}.contents li{display:grid;grid-template-columns:120px minmax(0,1fr);gap:20px;align-items:center;border-top:1px solid #b78b57;padding:12px 0}.contents li:last-child{border-bottom:1px solid #b78b57}.contents a{display:inline-flex;align-items:center;min-height:44px;color:#202923;text-decoration-color:#a74432;text-underline-offset:5px}.contents span{color:#3f604c;line-height:1.7}.note{border-left:3px solid #a74432;margin-top:48px;padding:4px 0 4px 20px;line-height:1.8;color:#3f604c}@media(max-width:600px){.intro{margin-bottom:44px}.fields{grid-template-columns:1fr}.contents{margin-top:50px}.contents li{grid-template-columns:1fr;gap:0}}
</style>
