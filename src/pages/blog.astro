---
import NovaShell from '../layouts/NovaShell.astro';
const entries = [
  { date: '2026-11-09', title: '玉衡动态候选与首页布局', text: '开发记录描述了玉球动态、静态降级与响应式布局，并记录了浏览器检查。参考图相似度、真实低性能设备及跨浏览器验证仍待完成。', source: '依据：NOVA 玉衡动态候选记录；提交 e15394a', status: '进行中' },
  { date: '2026-11-09', title: '手机首页布局调整', text: '仓库提交记录显示，对手机首页布局进行了调整；后续版式仍在迭代。', source: '依据：提交 16865a9', status: '持续迭代' },
  { date: '2026-11-08', title: '依赖迁移与路由验证记录', text: '仓库提交记录包含 Astro 7 依赖锁迁移及路由浏览器验证文档。具体验证范围以对应记录为准。', source: '依据：提交 5559ce5、07d8198', status: '已有记录' },
];
---
<NovaShell title="研究札记" description="依据仓库记录整理的工程研究日志。" active="/blog">
  <div class="page"><header class="intro"><p class="eyebrow">研究记录 / 札记</p><h1>记录过程，<br />也记录未完成。</h1><p>从实际提交和开发记录出发，留下问题、尝试与仍待验证的部分。</p></header>
    <section class="entries" aria-label="研究日志">{entries.map((entry) => <article><div class="date"><time datetime={entry.date}>{entry.date}</time><span>{entry.status}</span></div><div><h2>{entry.title}</h2><p>{entry.text}</p><p class="source">{entry.source}</p></div></article>)}</section>
  </div>
</NovaShell>
<style>
  .page{max-width:1120px;margin:auto;padding:clamp(64px,9vw,110px) clamp(20px,5vw,72px) 20px;overflow-wrap:anywhere}.intro{max-width:750px;margin-bottom:64px}.eyebrow,.date,.source{color:#52735e;font:12px ui-monospace,monospace}.eyebrow{letter-spacing:.08em}h1{margin:20px 0 24px;font-size:clamp(36px,6vw,70px);line-height:1.2;font-weight:500}.intro>p:last-child{font-size:17px;color:#3f604c;line-height:1.8}.entries article{display:grid;grid-template-columns:150px minmax(0,1fr);gap:30px;padding:30px 0;border-top:1px solid #b78b57}.entries article:last-child{border-bottom:1px solid #b78b57}.date{display:flex;flex-direction:column;gap:12px;line-height:1.6}.date span{color:#8f6438}h2{font-size:25px;font-weight:500;margin:0 0 12px}article p{max-width:680px;margin:0;line-height:1.8;color:#3f604c}.source{margin-top:15px;line-height:1.7}@media(max-width:600px){.intro{margin-bottom:44px}.entries article{grid-template-columns:1fr;gap:14px}.date{flex-direction:row;gap:18px}}
</style>
