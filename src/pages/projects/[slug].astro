---
import NovaShell from '../../layouts/NovaShell.astro';
import { projects } from '../../data/projects';
import type { Project } from '../../data/projects';
export function getStaticPaths() {
  return projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, index } }));
}
interface Props { project: Project; index: number; }
const { project, index } = Astro.props;
const previous = index > 0 ? projects[index - 1] : undefined;
const next = index < projects.length - 1 ? projects[index + 1] : undefined;
---
<NovaShell title={project.title} description={project.subtitle} active="/projects">
  <div class="page">
    <a class="back" href="/projects">← 返回项目中心</a>
    <header class="intro"><p class="eyebrow">项目档案 / {String(index + 1).padStart(2, '0')}</p><h1>{project.title}</h1><p class="subtitle">{project.subtitle}</p><div class="meta"><span>{project.domain}</span><span class="status">{project.status}</span><span>档案整理：{project.updated}</span></div><ul class="tags" aria-label="技术与方法">{project.stack.map(item => <li>{item}</li>)}</ul></header>
    <div class="content">
      <section class="block"><p class="section-number">01</p><div><h2>要解决的问题</h2><p>{project.problem}</p></div></section>
      <section class="block"><p class="section-number">02</p><div><h2>技术方案</h2><p>{project.approach}</p></div></section>
      <section class="block"><p class="section-number">03</p><div><h2>实施步骤</h2><ol>{project.steps.map(item => <li>{item}</li>)}</ol></div></section>
      <section class="block"><p class="section-number">04</p><div><h2>当前成果</h2><ul>{project.results.map(item => <li>{item}</li>)}</ul></div></section>
      <section class="block"><p class="section-number">05</p><div><h2>后续事项</h2><ul>{project.pending.map(item => <li>{item}</li>)}</ul></div></section>
      <section class="block"><p class="section-number">06</p><div><h2>资料缺口</h2><ul>{project.gaps.map(item => <li>{item}</li>)}</ul></div></section>
    </div>
    <nav class="related" aria-label="相关知识与工具">{project.links.map(link => <a href={link.href}>{link.label} <span aria-hidden="true">→</span></a>)}</nav>
    <nav class="pagination" aria-label="项目导航"><a href="/projects/">← 返回项目列表</a><div>{previous && <a href={`/projects/${previous.slug}/`}>上一个：{previous.title}</a>}{next && <a href={`/projects/${next.slug}/`}>下一个：{next.title}</a>}</div></nav>
  </div>
</NovaShell>
<style>
  .back { display: inline-flex; align-items: center; min-height: 44px; margin: 8px 0 4px; color: #3f604c; text-decoration: none; font-size: .95rem; }
  .back:hover { color: #a74432; }
.page{max-width:1100px;margin:auto;padding:0 clamp(20px,5vw,72px);color:#202923;overflow-wrap:anywhere}.intro{padding:clamp(64px,9vw,120px) 0 48px}.eyebrow,.section-number{font:12px ui-monospace,monospace;letter-spacing:.1em;color:#3f604c}.eyebrow{border-left:3px solid #a74432;padding-left:12px}h1,h2{font-family:"Songti SC","Noto Serif CJK SC",SimSun,serif;font-weight:600}h1{font-size:clamp(38px,6vw,72px);line-height:1.2;margin:25px 0 15px}.subtitle{font-size:18px;line-height:1.8;color:#4b554b;max-width:700px}.meta{display:flex;align-items:center;flex-wrap:wrap;gap:12px 20px;color:#596359;font-size:13px}.status{border:1px solid #b78b57;padding:5px 10px;color:#3f604c}.tags{display:flex;flex-wrap:wrap;gap:6px;list-style:none;padding:0;margin:20px 0 0}.tags li{padding:5px 9px;background:#e6ebe2;color:#3f604c;font-size:12px}.content{border-top:1px solid #cbb99e}.block{display:grid;grid-template-columns:64px minmax(0,1fr);gap:20px;padding:30px 0;border-bottom:1px solid #ddd2c0}.block>div{min-width:0}.section-number{margin:7px 0}h2{font-size:25px;margin:0 0 14px}.block p:not(.section-number),.block li{line-height:1.9;color:#414c42}.block ul,.block ol{padding-left:1.35em;margin:0}.block li+li{margin-top:8px}.related,.pagination{display:flex;flex-wrap:wrap;gap:12px;padding-top:24px}.pagination{justify-content:space-between;border-top:1px solid #cbb99e;margin-top:22px}.pagination div{display:flex;flex-wrap:wrap;gap:12px}.related a,.pagination a{display:inline-flex;align-items:center;min-height:44px;padding:0 12px;color:#3f604c;text-decoration:none}.related a:hover,.pagination a:hover{text-decoration:underline;text-decoration-color:#a74432;text-underline-offset:5px}.related a:focus-visible,.pagination a:focus-visible{outline:3px solid #52735e;outline-offset:3px}@media(max-width:600px){.block{grid-template-columns:38px minmax(0,1fr);gap:10px}.pagination{display:block}.pagination div{margin-top:8px}}
</style>