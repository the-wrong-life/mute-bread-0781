---
import NovaShell from '../layouts/NovaShell.astro';
import { projects } from '../data/projects';
---
<NovaShell title="项目中心" description="以真实记录整理的工程项目档案。" active="/projects">
  <div class="page">
    <header class="page-head"><p class="eyebrow">项目档案 / PROJECTS</p><h1>把想法，<br />变成可验证的工作。</h1><p class="lede">从问题出发，记录方案、实验与尚未补齐的资料。这里的项目持续更新，未完成的部分会如实标注。</p></header>
    <nav class="filters" aria-label="按领域筛选项目">
      <button type="button" class="filter" data-filter="" aria-pressed="true">全部<span class="count">{projects.length}</span></button>
      {[...new Set(projects.map((p) => p.domain))].map((domain) => (
        <button type="button" class="filter" data-filter={domain} aria-pressed="false">
          {domain}<span class="count">{projects.filter((p) => p.domain === domain).length}</span>
        </button>
      ))}
    </nav>
    <p class="filter-status" role="status" aria-live="polite"></p>
    <section aria-label="项目列表" class="grid">
      {projects.map((project, index) => <a class="card" href={`/projects/${project.slug}/`} data-domain={project.domain}>
        <div class="card-top"><span class="number">{String(index + 1).padStart(2, '0')}</span><span class="status">{project.status}</span></div>
        <div class="card-main"><p class="domain">{project.domain}</p><h2>{project.title}</h2><p class="summary">{project.subtitle}</p></div>
        <div class="card-bottom"><ul aria-label="技术与方法">{project.stack.map(item => <li>{item}</li>)}</ul><span class="arrow" aria-hidden="true">↗</span></div>
      </a>)}
    </section>
    <p class="note">档案整理日期不等于测试日期。实测与待验证事项请在各项目详情中查看。</p>
    <script>
      // 首页领域入口用 ?domain= 带筛选条件进来；静态页无 JS 时仍是完整列表，
      // 所以筛选只是增强，不做服务端裁剪，避免"链接点进来一片空白"。
      const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter'));
      const cards = Array.from(document.querySelectorAll<HTMLElement>('.card'));
      const status = document.querySelector<HTMLElement>('.filter-status');
      const apply = (value: string) => {
        let shown = 0;
        for (const card of cards) {
          const hit = !value || card.dataset.domain === value;
          card.hidden = !hit;
          if (hit) shown += 1;
        }
        for (const btn of buttons) btn.setAttribute('aria-pressed', String(btn.dataset.filter === value));
        if (status) status.textContent = value ? `已筛选「${value}」，共 ${shown} 个项目。` : `共 ${shown} 个项目。`;
      };
      for (const btn of buttons) {
        btn.addEventListener('click', () => {
          const value = btn.dataset.filter || '';
          const url = new URL(window.location.href);
          if (value) url.searchParams.set('domain', value);
          else url.searchParams.delete('domain');
          window.history.replaceState(null, '', url);
          apply(value);
        });
      }
      const initial = new URL(window.location.href).searchParams.get('domain') || '';
      if (initial) apply(initial);
    </script>
    <nav class="related" aria-label="相关入口"><a href="/docs">工程知识 <span aria-hidden="true">→</span></a><a href="/tools">工程工具 <span aria-hidden="true">→</span></a></nav>
  </div>
</NovaShell>
<style>
.page{max-width:1280px;margin:auto;padding:0 clamp(20px,5vw,72px);color:#202923;overflow-wrap:anywhere}.page-head{padding:clamp(64px,9vw,120px) 0 52px;max-width:820px}.eyebrow,.number,.domain{font:12px ui-monospace,monospace;letter-spacing:.1em;color:#3f604c}.eyebrow{border-left:3px solid #a74432;padding-left:12px}h1,h2{font-family:"Songti SC","Noto Serif CJK SC",SimSun,serif;font-weight:600}h1{font-size:clamp(38px,6vw,72px);line-height:1.22;margin:25px 0}.lede{max-width:650px;line-height:1.9;color:#4b554b}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.card[hidden]{display:none}.card{min-width:0;min-height:250px;display:flex;flex-direction:column;justify-content:space-between;gap:28px;padding:clamp(22px,3vw,32px);border:1px solid #cbb99e;background:#faf8f1;color:inherit;text-decoration:none;transition:border-color .18s,background .18s}.card:hover{border-color:#8f6438;background:#fffdf7}.card:focus-visible,.related a:focus-visible{outline:3px solid #52735e;outline-offset:3px}.card-top,.card-bottom{display:flex;align-items:center;justify-content:space-between;gap:16px}.status{border:1px solid #b78b57;color:#3f604c;padding:5px 10px;font-size:12px}.card-main{min-width:0}.domain{margin:0 0 12px}.card h2{font-size:clamp(24px,3vw,32px);margin:0 0 10px}.summary{margin:0;color:#596359;line-height:1.7}.card-bottom ul{display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0;list-style:none}.card-bottom li{font-size:12px;color:#3f604c;background:#e6ebe2;padding:5px 9px}.arrow{font-size:22px;color:#8f6438}.note{margin:32px 0;color:#596359;font-size:14px;line-height:1.8}.related{display:flex;flex-wrap:wrap;gap:14px;border-top:1px solid #cbb99e;padding-top:20px}.related a{display:inline-flex;align-items:center;gap:18px;min-height:44px;padding:0 12px;color:#3f604c;text-decoration:none}.related a:hover{text-decoration:underline;text-decoration-color:#a74432;text-underline-offset:5px}.filters{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 8px}.filter{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 14px;border:1px solid #cbb99e;background:#faf8f1;color:#33463b;font:inherit;font-size:14px;cursor:pointer}.filter:hover{border-color:#8f6438}.filter[aria-pressed="true"]{background:#33463b;border-color:#33463b;color:#f6f2e8}.filter:focus-visible{outline:3px solid #52735e;outline-offset:3px}.count{font:12px ui-monospace,monospace;opacity:.75}.filter-status{margin:0 0 22px;min-height:20px;color:#596359;font-size:14px}@media(max-width:700px){.grid{grid-template-columns:minmax(0,1fr)}.card{min-height:220px}.page-head{padding-bottom:38px}}@media(prefers-reduced-motion:reduce){.card{transition:none}}
</style>
