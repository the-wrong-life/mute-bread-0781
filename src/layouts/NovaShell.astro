---
export interface Props { title: string; description?: string; active?: string; robots?: 'noindex'; }
const { title, description = 'DIY 工程实验室 — 工程、实验与可复用工具。', active = '', robots } = Astro.props;
// canonical 必须由 site + 当前路径生成，而不是硬编码：文档详情、项目详情共用一个布局。
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://www.token-xxo.cn').href;
const links = [
  { href: '/projects', label: '项目' }, { href: '/docs', label: '文档' },
  { href: '/tools', label: '工具' }, { href: '/ai', label: 'AI' },
  { href: '/blog', label: '札记' }, { href: '/about', label: '关于' }
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e6" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {/* 开发预览页与材质试验台不在 sitemap 里：显式 noindex，避免"不收录"只靠 sitemap 缺项这种弱信号。 */}
    {robots === 'noindex' && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DIY 工程实验室" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{title} · DIY 工程实验室</title>
    <!-- 托管平台（阿里云 ESA Pages 免费版）不应用仓库里的 public/_headers，
         这些头部只能在 HTML 里表达：referrer 与 CSP 用 meta，HSTS/X-Frame-Options 仍需控制台设置。 -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <!-- ESA 边缘会注入自家 RUM：脚本来自 rjsprbi.myalicdn.com，上报接口在 rumtc.myalicdn.com，
         两个域名都要放行，否则页面每隔几秒就会报一条 CSP 拦截错误。 -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://*.myalicdn.com; font-src 'self'; connect-src 'self' https://*.myalicdn.com https://*.ialicdn.com; object-src 'none'; base-uri 'self'; form-action 'self'" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header">
      <!-- §43：axe-core 报 label-content-name-mismatch（serious）——aria-label 必须包含可见文字，
           否则语音控制用户说"点击 DIY 工程实验室"无法命中该链接。 -->
      <a class="brand" href="/" aria-label="DIY 工程实验室 返回首页"><span class="brand-mark" aria-hidden="true">✦</span><span>DIY 工程实验室</span></a>
      <nav class="desktop-navigation" aria-label="主导航">{links.map((link) => <a href={link.href} aria-current={active === link.href ? 'page' : undefined}>{link.label}</a>)}</nav>
      <details class="navigation">
        <summary aria-label="切换主导航" aria-controls="primary-navigation"><span class="menu-icon" aria-hidden="true"></span><span>导航</span></summary>
        <nav id="primary-navigation" aria-label="移动端主导航">{links.map((link) => <a href={link.href} aria-current={active === link.href ? 'page' : undefined}>{link.label}</a>)}</nav>
      </details>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer><span>DIY 工程实验室</span><span>工程想法 → 可验证现实</span><span>© 2026 DIY 工程实验室</span></footer>
  </body>
</html>
<script>
  const skip = document.querySelector<HTMLAnchorElement>('.skip-link');
  const main = document.querySelector<HTMLElement>('#main-content');
  skip?.addEventListener('click', () => main?.focus());

  const menu = document.querySelector<HTMLDetailsElement>('.navigation');
  const trigger = menu?.querySelector<HTMLElement>('summary');
  const panel = menu?.querySelector<HTMLElement>('#primary-navigation');
  if (menu && trigger && panel) {
    const syncMenu = (focusFirst = false) => {
      trigger.setAttribute('aria-expanded', String(menu.open));
      panel.hidden = !menu.open;
      if (menu.open && focusFirst) panel.querySelector<HTMLAnchorElement>('a')?.focus();
    };
    syncMenu();
    menu.addEventListener('toggle', () => syncMenu(menu.open && document.activeElement === trigger));
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        syncMenu();
        trigger.focus();
      }
    });
  }
</script>
<style>
  :global(html){background:#f4f0e6;color:#202923}
  :global(body){margin:0;min-width:320px;background:#f4f0e6;font-family:ui-sans-serif,system-ui,"Noto Sans CJK SC",sans-serif}
  :global(*){box-sizing:border-box}
  :global(h1),:global(h2),:global(h3){font-family:"Songti SC","Noto Serif CJK SC",SimSun,serif}
  :global(a:focus-visible),:global(button:focus-visible),summary:focus-visible{outline:2px solid #a74432;outline-offset:3px}
  main{min-width:0;overflow-wrap:anywhere}
  .skip-link{position:absolute;z-index:20;left:16px;top:8px;padding:12px;background:#202923;color:#f4f0e6;transform:translateY(-160%)}
  .skip-link:focus{transform:translateY(0)}
  .site-header{display:flex;justify-content:space-between;align-items:center;gap:24px;max-width:1280px;margin:auto;padding:20px clamp(20px,5vw,72px);border-bottom:1px solid #b78b57}
  .brand{display:flex;gap:11px;align-items:center;min-height:44px;color:#202923;text-decoration:none;font-size:15px;font-weight:650;white-space:nowrap}
  .brand-mark{color:#a74432;font-size:20px}
  .navigation{display:none}
  .desktop-navigation,nav{display:flex;gap:clamp(12px,2.5vw,30px)}
  nav a{display:inline-flex;align-items:center;min-height:44px;padding:6px 2px;color:#3f604c;text-decoration:none;font-size:14px}
  nav a:hover{color:#202923}
  nav a[aria-current="page"]{color:#202923;box-shadow:inset 0 -2px #a74432}
  footer{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;max-width:1280px;margin:80px auto 0;padding:26px clamp(20px,5vw,72px);border-top:1px solid #b78b57;color:#3f604c;font-size:12px}
  @media(max-width:720px){
    .site-header{position:relative;padding:16px 20px}
    .desktop-navigation{display:none}
    .navigation{display:block;position:relative}
    summary{display:flex;align-items:center;gap:8px;min-width:44px;min-height:44px;padding:0 10px;list-style:none;color:#202923;cursor:pointer;border:1px solid #8f6438;border-radius:3px;font-size:13px}
    summary::-webkit-details-marker{display:none}
    .menu-icon,.menu-icon::before,.menu-icon::after{display:block;width:17px;height:2px;background:#52735e;position:relative}
    .menu-icon::before,.menu-icon::after{content:"";position:absolute;left:0}.menu-icon::before{top:-5px}.menu-icon::after{top:5px}
    .navigation nav{display:none;position:absolute;z-index:10;right:0;top:calc(100% + 8px);min-width:180px;padding:8px 14px;background:#f4f0e6;border:1px solid #b78b57;box-shadow:0 8px 24px #20292320}
    .navigation[open] nav{display:flex;flex-direction:column;gap:0}
    .navigation nav a{min-height:44px;border-bottom:1px solid #d9d1bf}
    .navigation nav a:last-child{border-bottom:0}
    footer{flex-direction:column;gap:6px;margin-top:36px}
  }
</style>